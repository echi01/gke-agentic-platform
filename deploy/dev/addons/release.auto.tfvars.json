{
  "kube_context": "platform-dev",
  "repository_url": "git@github.com:echi01/gke-agentic-platform.git",
  "revision": "b8a27477a1e1016d5c2ba7e4e8d5f58f13fbb582",
  "manage_via_gitops": true,
  "enabled_addons": {
    "traefik": true,
    "certificate-issuers": true,
    "cert-manager": true,
    "istio-gateway": false,
    "kubernetes-mcp": true
  },
  "addon_values": {
    "argo-cd": {
      "configs": {
        "cm": {
          "admin.enabled": false,
          "exec.enabled": false,
          "resource.customizations.health.argoproj.io_Application": "hs = { status = \"Progressing\", message = \"Waiting for child reconciliation\" }\nif obj.status ~= nil and obj.status.health ~= nil then\n  hs.status = obj.status.health.status\n  hs.message = obj.status.health.message or \"\"\nend\nreturn hs\n"
        },
        "params": {
          "server.insecure": false
        },
        "rbac": {
          "policy.default": "role:readonly",
          "policy.csv": "g, platform-operators, role:admin\n"
        }
      },
      "server": {
        "service": {
          "type": "ClusterIP"
        }
      },
      "redis": {
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "64Mi"
          }
        }
      },
      "dex": {
        "enabled": false
      },
      "notifications": {
        "enabled": false
      },
      "controller": {
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "384Mi"
          }
        }
      },
      "repoServer": {
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "256Mi"
          }
        }
      }
    },
    "cert-manager": {
      "crds": {
        "enabled": true
      },
      "replicaCount": 1
    },
    "traefik": {
      "deployment": {
        "replicas": 1,
        "podAnnotations": {
          "sidecar.istio.io/inject": "true",
          "proxy.istio.io/config": "{\"holdApplicationUntilProxyStarts\": true}",
          "traffic.sidecar.istio.io/excludeInboundPorts": "8000,8443,8080,9100"
        }
      },
      "providers": {
        "kubernetesIngress": {
          "enabled": true,
          "nativeLBByDefault": true,
          "namespaces": [
            "progressbar-dev-edge"
          ]
        },
        "kubernetesCRD": {
          "enabled": true,
          "nativeLBByDefault": true,
          "allowCrossNamespace": true,
          "namespaces": [
            "traefik",
            "progressbar-dev-edge",
            "progressbar-dev"
          ]
        }
      },
      "serviceAccount": {
        "name": "traefik"
      },
      "resources": {
        "requests": {
          "cpu": "100m",
          "memory": "128Mi"
        },
        "limits": {
          "cpu": "1",
          "memory": "512Mi"
        }
      },
      "ingressRoute": {
        "dashboard": {
          "enabled": false
        }
      },
      "service": {
        "spec": {
          "type": "LoadBalancer",
          "loadBalancerClass": "networking.gke.io/l4-regional-external"
        }
      },
      "metrics": {
        "prometheus": {
          "serviceMonitor": {
            "enabled": false
          }
        }
      }
    },
    "istiod": {
      "cni": {
        "enabled": true
      },
      "meshConfig": {
        "accessLogFile": "/dev/stdout",
        "defaultConfig": {
          "holdApplicationUntilProxyStarts": true
        }
      },
      "global": {
        "proxy": {
          "image": "docker.io/istio/proxyv2@sha256:7c3f8161753a0c0f5033a37f84387d68248f828bfa5123368dd5949c443ca6c3"
        }
      },
      "autoscaleEnabled": true,
      "autoscaleMin": 1,
      "autoscaleMax": 2,
      "resources": {
        "requests": {
          "cpu": "100m",
          "memory": "256Mi"
        }
      }
    },
    "kube-prometheus-stack": {
      "prometheus": {
        "prometheusSpec": {
          "retention": "2d",
          "maximumStartupDurationSeconds": 300,
          "podMetadata": {
            "annotations": {
              "sidecar.istio.io/inject": "true",
              "sidecar.istio.io/nativeSidecar": "true"
            }
          },
          "serviceMonitorSelectorNilUsesHelmValues": false,
          "podMonitorSelectorNilUsesHelmValues": false,
          "ruleSelectorNilUsesHelmValues": false,
          "resources": {
            "requests": {
              "cpu": "250m",
              "memory": "512Mi"
            },
            "limits": {
              "cpu": "1",
              "memory": "2Gi"
            }
          }
        }
      },
      "grafana": {
        "admin": {
          "existingSecret": "grafana-admin"
        },
        "service": {
          "type": "ClusterIP"
        },
        "sidecar": {
          "dashboards": {
            "searchNamespace": "ALL"
          }
        }
      },
      "kubeEtcd": {
        "enabled": false
      },
      "kubeControllerManager": {
        "enabled": false
      },
      "kubeScheduler": {
        "enabled": false
      },
      "alertmanager": {
        "enabled": false
      }
    },
    "prometheus-adapter": {
      "prometheus": {
        "url": "http://kube-prometheus-stack-prometheus.monitoring.svc",
        "port": 9090
      },
      "rules": {
        "default": true,
        "custom": [
          {
            "seriesQuery": "progressbar_http_requests_total{namespace!=\"\",pod!=\"\"}",
            "resources": {
              "overrides": {
                "namespace": {
                  "resource": "namespace"
                },
                "pod": {
                  "resource": "pod"
                }
              }
            },
            "name": {
              "matches": "^progressbar_http_requests_total$",
              "as": "http_requests_per_second"
            },
            "metricsQuery": "sum(rate(<<.Series>>{<<.LabelMatchers>>}[2m])) by (<<.GroupBy>>)"
          }
        ]
      },
      "certManager": {
        "enabled": true
      },
      "listenPort": 10250
    },
    "certificate-issuers": {
      "email": "pb.simon.chi@gmail.com"
    },
    "kubernetes-mcp": {
      "image": "us-central1-docker.pkg.dev/project-fb85ba80-c9eb-43f0-af3/platform-dev/mcp@sha256:46605ceb7663572fbe2cdce206e61feff7cc7d2c95f02049d2fbad0f2c53c2c2",
      "apiCidrs": [
        "10.48.0.1/32",
        "172.16.0.2/32"
      ]
    }
  }
}
