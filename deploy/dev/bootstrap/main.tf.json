{
  "terraform": {
    "required_version": ">= 1.8",
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 7.0"
      },
      "github": {
        "source": "integrations/github",
        "version": "~> 6.13.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.7"
      },
      "tls": {
        "source": "hashicorp/tls",
        "version": "~> 4.1"
      }
    },
    "backend": {
      "gcs": {}
    }
  },
  "provider": {
    "google": {
      "project": "${local.environment.projectId}",
      "region": "${local.environment.region}"
    },
    "github": {
      "owner": "${local.environment.githubOwner}"
    }
  },
  "locals": {
    "environment": "${jsondecode(file(\"${path.module}/../environment.json\"))}",
    "repositories": {
      "gke-agentic-platform": "Reusable Google Kubernetes platform with local add-ons, Argo CD, Zero Trust and agent operations",
      "progressbar-application": "Progress Bar native apps, API and application-owned agent workloads"
    },
    "secret_ids": {
      "gke-agentic-platform": "platform-dev-argocd-infrastructure",
      "progressbar-application": "platform-dev-argocd-application",
      "grafana": "platform-dev-grafana-admin"
    },
    "bootstrap_active": "${try(local.environment.runtimeEnabled, true)}"
  },
  "resource": {
    "github_repository": {
      "owned": {
        "for_each": "${local.repositories}",
        "name": "${each.key}",
        "description": "${each.value}",
        "visibility": "private",
        "auto_init": false,
        "lifecycle": {
          "prevent_destroy": true
        },
        "has_issues": true,
        "has_projects": true
      }
    },
    "tls_private_key": {
      "repository": {
        "for_each": "${local.bootstrap_active ? local.repositories : {}}",
        "algorithm": "ED25519"
      }
    },
    "github_repository_deploy_key": {
      "argocd": {
        "for_each": "${local.bootstrap_active ? local.repositories : {}}",
        "repository": "${github_repository.owned[each.key].name}",
        "title": "Progress Bar dev Argo CD read-only",
        "key": "${tls_private_key.repository[each.key].public_key_openssh}",
        "read_only": true,
        "lifecycle": {
          "create_before_destroy": true
        }
      }
    },
    "google_secret_manager_secret": {
      "bootstrap": {
        "for_each": "${local.bootstrap_active ? local.secret_ids : {}}",
        "project": "${local.environment.projectId}",
        "secret_id": "${each.value}",
        "replication": {
          "auto": {}
        }
      }
    },
    "google_secret_manager_secret_version": {
      "repository": {
        "for_each": "${local.bootstrap_active ? local.repositories : {}}",
        "secret": "${google_secret_manager_secret.bootstrap[each.key].id}",
        "secret_data": "${jsonencode({sshPrivateKey=tls_private_key.repository[each.key].private_key_openssh})}"
      },
      "grafana": {
        "secret": "${google_secret_manager_secret.bootstrap[\"grafana\"].id}",
        "secret_data": "${random_password.grafana[0].result}",
        "count": "${local.bootstrap_active ? 1 : 0}"
      }
    },
    "random_password": {
      "grafana": {
        "length": 40,
        "special": false,
        "count": "${local.bootstrap_active ? 1 : 0}"
      }
    }
  },
  "import": [
    {
      "to": "github_repository.owned[\"gke-agentic-platform\"]",
      "id": "gke-agentic-platform"
    },
    {
      "to": "github_repository.owned[\"progressbar-application\"]",
      "id": "progressbar-application"
    }
  ],
  "moved": [
    {
      "from": "random_password.grafana",
      "to": "random_password.grafana[0]"
    },
    {
      "from": "google_secret_manager_secret_version.grafana",
      "to": "google_secret_manager_secret_version.grafana[0]"
    }
  ]
}
